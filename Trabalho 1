void printInfo(Process* lista, int ID){
    Process item = lista[ID];
    printf("%02d %02d:%02d:%02d %s \n", item.prior, item.tempo.hor, item.tempo.min, item.tempo.seg,item.descrip);
}



void lerComando(Process* lista, int* n, int* isExit, int* stateFlag){
    char info[70];
    fgets(info, 70, stdin);
    
    char comando[7];
    int i = 0;
    while ((info[i] != ' ') && (info[i] != '\n') && (info[i] != '\0') && (i < 6)){
        comando[i] = info[i];
        i++;
    }
    comando[i] = '\0';
    i = i + 2;
    
    if (strcmp(comando,"add") == 0){
        i--;
        adicionar(lista, n, &i, info, stateFlag);
    } else if (strcmp(comando,"next") == 0){
        char ordem = info[i];
        printInfo(lista,(procurar(lista, ordem, (*n), stateFlag)));
        printf("\n");
    } else if (strcmp(comando,"exec") == 0){
        char ordem = info[i];
        executar(lista, n, ordem, stateFlag);
    } else if (strcmp(comando,"change") == 0){
        char ordem = info[i];
        i = i + 2;
        mudar(lista, info, &i, ordem, n, stateFlag);
    }else if (strcmp(comando,"print") == 0){
        char ordem = info[i];
        
        if (((*stateFlag) == 1) && (ordem == 'p')){
            for(int c = (*n) - 1; c >= 0; c--){
                printInfo(lista, c);
            }
            printf("\n");
            return;
        }
        if ((((*stateFlag) == 2) && (ordem == 't'))){
            for(int c = (*n) - 1; c >= 0; c--){
                printInfo(lista, c);
            }
            printf("\n");
            return;
        }
        mergeSort(lista, 0, (*n) - 1, ordem, stateFlag);
        
            for(int c = (*n) - 1; c >= 0; c--){
                printInfo(lista, c);
            }
            printf("\n");
    } else if (strcmp(comando,"quit") == 0){
        (*isExit)++;
    }
}
