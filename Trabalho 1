//MERGE SORT


void merge(Process* lista, int l, int m, int r, char ordem){
    
    int i, j, k;
    int n1 = m - l + 1;
    int n2 = r - m;

    Process leftSide[n1], rightSide[n2];

    for (i = 0; i < n1; i++){
        leftSide[i] = lista[l + i];
    }
    for (j = 0; j < n2; j++){
        rightSide[j] = lista[m + 1 + j];
    }

    i = 0;
    j = 0;
    k = l;
    while (i < n1 && j < n2) {
        if (ordem == 'p'){
            if (leftSide[i].prior <= rightSide[j].prior) {
                lista[k] = leftSide[i];
                i++;
            }
            else {
                lista[k] = rightSide[j];
                j++;
            }
            k++;
        } else if (ordem == 't'){
            //printf("%d vs %d\n",calcTempoTotal(leftSide[i].tempo), calcTempoTotal(rightSide[j].tempo));
            if (calcTempoTotal(leftSide[i].tempo) >= calcTempoTotal(rightSide[j].tempo)) {
                lista[k] = leftSide[i];
                i++;
            }
            else {
                lista[k] = rightSide[j];
                j++;
            }
            k++;
        }
    }


    while (i < n1) {
        lista[k] = leftSide[i];
        i++;
        k++;
    }


    while (j < n2) {
        lista[k] = rightSide[j];
        j++;
        k++;
    }
}


void mergeSort(Process* lista, int l, int r, char ordem, int* stateFlag){
    
    if (ordem == 'p'){
        *stateFlag = 1;
    }
    if (ordem == 't'){
        *stateFlag = 2;
    }
        
    
    if (l < r) {
        int m = l + (r - l) / 2;

        mergeSort(lista, l, m, ordem, stateFlag);
        mergeSort(lista, m + 1, r, ordem, stateFlag);

        merge(lista, l, m, r, ordem);
    }
}

