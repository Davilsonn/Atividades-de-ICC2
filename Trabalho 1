//ALOCACAO DINAMICA DA LISTA
////////////////
Process* criarLista (Process* lista, int m){
    lista = malloc(m * sizeof(Process));
    if (lista == NULL){
        printf("Erro na alocação!!!");
        exit(1);
    }
    return(lista);
}
////////////////

Process* expandirLista (Process* lista, int m){
    Process* temp = realloc(lista, m * sizeof(Process));
    if (temp == NULL){
        printf("Erro na realocação!!!");
        free(lista);
        exit(1);
    }
    return(temp);
}
