//// ==> CHANGE
void mudar(Process* lista, char* comando, int* i, char ordem, int* n, int* stateFlag){
    
    int ID = -1;
    
    if (ordem == 'p'){
        int priorOld = 0;
        while (comando[(*i)] != '|'){
            priorOld = priorOld * 10;
            priorOld = priorOld + comando[(*i)] - '0';
            (*i)++;
        }
        
        for (int c = 0; c < (*n); c++){
            if (lista[c].prior == priorOld){
                ID = c;
            }
        }
        if (ID == -1){
            printf("Nao existe na lista\n");
            return;
        }
        
        (*i)++;
        int priorNew = 0;
        while ((comando[(*i)] != '\n') && (comando[(*i)] != '\0')){
            priorNew = priorNew * 10;
            priorNew = priorNew + comando[(*i)] - '0';
            //printf("%d\n", comando[*i] - '0');
            (*i)++;
        }
        lista[ID].prior = priorNew;
    } else if (ordem == 't'){
        Tempo tempoOld = lerTempo(comando, i);
        //printf("Tempo pra comparar: %d:%d:%d\n",tempoOld.hor,tempoOld.min,tempoOld.seg);
        
        for (int c = 0; c < (*n); c++){
            if (compareTempo(lista[c].tempo, tempoOld)){
                ID = c;
            }
        }
        if (ID == -1){
            printf("Nao existe na lista\n");
            return;
        }
        (*i)++;
        Tempo tempoNew = lerTempo(comando, i);
        
        lista[ID].tempo = tempoNew;
    }
    
    
    // ENCONTRANDO NOVO LOCAL
    if ((*stateFlag) == 1){
        while (lista[ID].prior < lista[ID - 1].prior){
            swtichAnterior(lista, ID);
            ID--;
        }
        while (lista[ID].prior > lista[ID + 1].prior){
            Process temp = lista[ID];
            lista[ID] = lista[ID + 1];
            lista[ID + 1] = temp;
            ID++;
        }
    } else if ((*stateFlag) == 2){
        while (calcTempoTotal(lista[ID].tempo) > calcTempoTotal(lista[ID - 1].tempo)){
            swtichAnterior(lista, ID);
            ID--;
        }
        while (calcTempoTotal(lista[ID].tempo) < calcTempoTotal(lista[ID + 1].tempo)){
            Process temp = lista[ID];
            lista[ID] = lista[ID + 1];
            lista[ID + 1] = temp;
            ID++;
        }
    }
    
    
}


