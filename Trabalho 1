//// ==> EXEC
void executar(Process* lista, int* n, char ordem, int* stateFlag){
    int ID;
    if (((*stateFlag) == 1) && (ordem == 'p')){
        ID = (*n) - 1;
    }else if (((*stateFlag) == 2) && (ordem == 't')){
        ID = (*n) - 1;
    }else{
        ID = procurar(lista, ordem, (*n), stateFlag);
    }
    
    for (int i = ID; i < ((*n) - 1); i++){
            lista[i] = lista[i + 1];
        }
    (*n)--;
}
