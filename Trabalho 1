//// ==> ADD
void adicionar(Process* lista, int* n, int* i, char* comando, int* stateFlag){
    Process novoItem;
    
    int prioridade = 0;
    while (comando[(*i)] != ' '){
        prioridade = prioridade * 10;
        prioridade = prioridade + comando[(*i)] - '0';
        (*i)++;
    }
    novoItem.prior = prioridade;
    (*i)++;
    novoItem.tempo = lerTempo(comando, i);
   
    int j = 0;
       while ((comando[(*i)] != '\n') && (comando[(*i)] != '\0')){
        novoItem.descrip[j] = comando[(*i)];
        (*i)++;
        j++;
    }
    novoItem.descrip[j] = '\0';
    lista[(*n)] = novoItem;
    
    if ((*stateFlag) == 1){
        for (int i = (*n); i >= 0; i--){
            while (lista[i].prior < lista[i - 1].prior){
                swtichAnterior(lista, i);
            }
            break;
        }
        (*n)++;
        return;
    } else if ((*stateFlag) == 2){
        for (int i = (*n); i >= 0; i--){
            while (calcTempoTotal(lista[i].tempo) > calcTempoTotal(lista[i - 1].tempo)){
                swtichAnterior(lista, i);
            }
            break;
        }
        (*n)++;
        return;
    }
(*n)++;
}
