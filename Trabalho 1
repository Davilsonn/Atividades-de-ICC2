//FUCOES DE UTILIDADE

Tempo lerTempo(char* string, int* i){
    Tempo tempo;
    tempo.hor = 0;
    while (string[(*i)] != ':'){
        tempo.hor = tempo.hor * 10;
        tempo.hor = tempo.hor + string[(*i)] - '0';
        (*i)++;
    }
    (*i)++;
    
    tempo.min = 0;
    while (string[(*i)] != ':'){
        tempo.min = tempo.min * 10;
        tempo.min = tempo.min + string[(*i)] - '0';
        (*i)++;
    }
    (*i)++;
    
    tempo.seg = 0;
    while ((string[(*i)] != ' ') && (string[(*i)] != '|') && (string[(*i)] != '\n')){
        tempo.seg = tempo.seg * 10;
        tempo.seg = tempo.seg + string[(*i)] - '0';
        (*i)++;
    }
    (*i)++;
    
    return(tempo);
}
/////////////////////

int calcTempoTotal(Tempo tempo){
    int total = 0;
    total = total + (tempo.hor * 3600);
    total = total + (tempo.min * 60);
    total = total + tempo.seg;
    return(total);
}


int compareTempo(Tempo t1, Tempo t2){
    int isEqual = 1;
    
    if ((t1.hor != t2.hor) || (t1.min != t2.min) || (t1.seg != t2.seg)){
        return(0);
    } else {
        return(1);
    }
    
}

void swtichAnterior(Process* lista, int i){
    Process temp = lista[i];
    lista[i] = lista[i - 1];
    lista[i - 1] = temp;
}




