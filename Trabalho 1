//// ==> NEXT
int procurar(Process* lista, char ordem, int n, int* stateFlag){
    if ((ordem == 'p') && (*stateFlag) == 1){
        return (n - 1);
    }
    
    if ((ordem == 't') && (*stateFlag) == 2){
        return (n - 1);
    }
    
    
    if (ordem == 'p'){
        int max = 0;
        int maxID = 0;
        for (int i = 0; i < n; i++){
            if (lista[i].prior > max){
                max = lista[i].prior;
                maxID = i;
            }
        }
        
        return(maxID);
        
    } else if (ordem == 't'){
        int min = 99999999;
        int minID = 0;
        for (int i = 0; i < n; i++){
            int total = calcTempoTotal(lista[i].tempo);
            
            if (total < min){
                min = total;
                minID = i;
            }
        }
        
        return(minID);
    }
}
